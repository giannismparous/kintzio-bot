# Shared Gemini key (API only — never expose to the browser)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_DIMS=768

# Default: embedded PGlite (no Docker). For Docker Postgres instead:
# DATABASE_URL=postgresql://kintzio:kintzio@127.0.0.1:5433/kintzio
DATABASE_URL=pglite:./data/pglite

# API
API_PORT=8787
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=data/uploads
PUBLIC_API_URL=http://localhost:8787

# Web (Vite)
VITE_API_URL=http://localhost:8787

# --- Online only (see docs/ONLINE_SETUP.md and .env.online.example) ---
# AUTH_MODE=supabase
# STORAGE_MODE=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=kintzio
# VITE_AUTH_MODE=supabase
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=
