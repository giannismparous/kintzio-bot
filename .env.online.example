# Kintzio — single-service Render deployment (no Supabase)
NODE_ENV=production
AUTH_MODE=dev
STORAGE_MODE=local

GEMINI_API_KEY=your_gemini_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_DIMS=768

# Render persistent disk mounted at /var/data
DATABASE_URL=pglite:/var/data/pglite
UPLOAD_DIR=/var/data/uploads
KINTZIO_DATA_DIR=/var/data
KINTZIO_SEED_VERSION=v1

API_HOST=0.0.0.0

# Render generates this from render.yaml. It protects dashboard/admin endpoints.
ADMIN_API_KEY=replace_me_with_a_long_random_value
