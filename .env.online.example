# Kintzio — single-service Render deployment (no Supabase)
NODE_ENV=production
AUTH_MODE=dev
STORAGE_MODE=local

GEMINI_API_KEY=your_gemini_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_DIMS=768

# Prebuilt read-only knowledge index (no database or persistent disk required)
STATIC_BOT_BUNDLE=data/kintzio-bundle.json
API_HOST=0.0.0.0
