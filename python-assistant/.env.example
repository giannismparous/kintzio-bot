# DialogosAI — Kintzios assistant. Copy to .env and fill in.

# === Required for live LLM + embeddings ===
# Without a key the app still runs: retrieval falls back to the keyless TF-IDF
# leg and the persona endpoint returns a "no model configured" notice. The whole
# test suite runs keyless.
GEMINI_API_KEY=your-primary-gemini-key-here

# === Optional: extra keys for rate-limit rotation (same contract as BPAN) ===
# Model chain: first choice, then fallbacks (comma-separated). Leave unset to use
# the built-in list. Model ids get RETIRED — the 2.5 family stopped serving new
# keys and every request 404'd — so this is an env var precisely so a retirement
# is a one-line .env fix rather than a code change.
# Run `python manage.py models` to see what YOUR key can actually use.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# === Server ===
# BPAN=8002, Chios=8010, Kintzios=8020
APP_PORT=8020
# CORS_ORIGINS=http://localhost:8020,https://kkintzios.com

# === Admin / internal routes (leads dashboard + transcript search) ===
# REQUIRED in production. Unlike the BPAN app, auth here FAILS CLOSED: if these
# are unset, /admin/* and /internal/* return 503 rather than opening up.
INTERNAL_USER=admin
INTERNAL_PASSWORD=change-me

# Dev escape hatch ONLY — set to 1 to allow unauthenticated admin access on
# localhost. Never set this in production; it is logged loudly at startup.
# ALLOW_INSECURE_ADMIN=0

# === Leads / GDPR ===
LEAD_RETENTION_DAYS=180
# Calendly / HubSpot booking handoff. Empty → assistant offers email instead.
# SCHEDULER_URL=https://calendly.com/kkintzios/intro
PRIVACY_URL=/privacy-policy

# === Persona / retrieval ===
# Only chunks attributed to this speaker may feed public persona answers.
PERSONA_SPEAKER=Kintzios

# === Organisation facts (CAG block) — override individually if they change ===
# ORG_EMAIL=info@kkintzios.com
# ORG_WEBSITE=https://kkintzios.com

# === Indexing ===
# FORCE_REINDEX=1     # rebuild TF-IDF (+FAISS if key present) on next startup

# === Sources never rendered as clickable links (paid products, internal docs) ===
# DO_NOT_LINK=reboot-your-career,course,internal
